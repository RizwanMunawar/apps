# Copy to services/.env and edit. Never commit the real file.

# Signs admin session cookies. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
REDACT_SECRET_KEY=change-me-to-a-64-char-hex-string

# The first admin account, created on first boot if no admin exists yet.
REDACT_ADMIN_EMAIL=muhammadrizwanmunawar123@gmail.com
REDACT_ADMIN_PASSWORD=change-me-before-first-boot

# SQLite by default; swap for postgresql+psycopg://user:pass@host/db in production.
REDACT_DATABASE_URL=sqlite:///./redact.db

# Ultralytics weights the API runs. Mirrors the model the macOS app bundles.
REDACT_MODEL=yolo26n-seg.pt

# Matches YOLODetector.confidenceThreshold in the macOS app.
REDACT_CONFIDENCE=0.4

# Largest upload the API accepts, in megabytes.
REDACT_MAX_UPLOAD_MB=100

# --- Licensing ---
# Create with: python3 -m redactapi.licensetool keygen
# Only the PUBLIC half goes here. The private key stays on your machine, never on the server.
REDACT_LICENSE_PUBLIC_KEY=

# Separate, weaker keypair used only to sign 14-day trials, which must issue automatically.
# Anything signed with it is capped at 14 days by the verifier.
# Create with: python3 -m redactapi.licensetool keygen --trial
REDACT_TRIAL_PRIVATE_KEY=
REDACT_TRIAL_PUBLIC_KEY=

# Public origin for canonical URLs on the licensing pages.
REDACT_SITE_ORIGIN=https://rizwanai.com
